# Postgres (Supabase transaction-mode pooler for app runtime; session-mode for migrations)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Supabase Auth (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://odwoxbxkvmjjqvjyynko.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# One-time multi-tenancy migration only (scripts/migrate-multitenancy.ts)
# JENNY_USER_ID=<auth.users.id of the parent account that owns the Julian data>
# JENNY_EMAIL=bingjie.j.ouyang@gmail.com

# Payments (DORMANT — leave all of these unset until launch day)
# Master switch: only the exact string "true" turns the payment layer on.
# Off/unset = /unlock shows "everything is free" and checkout returns 404.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Stripe secret key (Dashboard → Developers → API keys). sk_test_... in dev.
STRIPE_SECRET_KEY=
# Signing secret for the /api/stripe/webhook endpoint (Dashboard → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Price id of the $9.99 one-time "lifetime unlock" product (price_...).
STRIPE_PRICE_ID=
